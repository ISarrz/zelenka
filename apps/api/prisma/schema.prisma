// Sprint 0 schema. Intentionally minimal:
//   - users + magic-link auth
//   - devices owned by users
//   - measurements (single row per sensor sample, all numeric fields nullable
//     so the firmware can grow into them without a migration each time)
// Plants, care rules, notifications, push subscriptions land in later sprints.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now())

  magicLinks       MagicLinkToken[]
  sessions         Session[]
  devices          Device[]
  plants           Plant[]
  identifications  IdentificationRequest[]
}

model MagicLinkToken {
  id         String    @id @default(uuid())
  token      String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model Session {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Device {
  id          String   @id @default(uuid())
  name        String
  deviceToken String   @unique
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  measurements Measurement[]
  plant        Plant?

  @@index([userId])
}

// Cached snapshot of a Perenual species we care about. Filled on demand
// the first time a user picks (or the identification flow returns) a given
// scientific name. Care thresholds are derived once and stored here so the
// hot path (`/api/devices/:id/latest`) doesn't have to hit perenual-db.
model PlantSpecies {
  id              String   @id @default(uuid())
  perenualId      Int?     @unique
  scientificName  String   @unique
  commonNameEn    String?
  commonNameRu    String?
  family          String?
  defaultImageUrl String?
  thresholds      Json     // see CareThresholds in src/lib/thresholds.ts
  rawDetails      Json?    // Perenual raw_details_v1_json snapshot — for debugging
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  plants Plant[]
}

// A user's plant. 1:1 with a Device (a device sits in one pot). Either
// linked to a PlantSpecies (after identification) or in "generic profile"
// mode while waiting for identification.
model Plant {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId   String?  @unique
  device     Device?  @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  speciesId  String?
  species    PlantSpecies? @relation(fields: [speciesId], references: [id], onDelete: SetNull)
  name       String        // user-chosen, e.g. "Фикус у окна"
  photoUrl   String?
  identifiedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId])
}

// Rate-limit log for Plant.id calls — 3 per rolling 7 days per user.
model IdentificationRequest {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  scientificName String?  // top suggestion's name, for audit
  rawResponse Json?

  @@index([userId, createdAt])
}

model Measurement {
  id         String   @id @default(uuid())
  deviceId   String
  device     Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  measuredAt DateTime
  createdAt  DateTime @default(now())

  // All numeric fields nullable so firmware can omit what isn't supported yet.
  temperatureC    Float?
  humidityPct     Float?
  pressureHpa     Float?
  lux             Float?
  soilMoistureRaw Int?
  soilMoisturePct Float?

  @@index([deviceId, measuredAt])
}
