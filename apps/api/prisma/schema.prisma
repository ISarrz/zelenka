// Sprint 0 schema. Intentionally minimal:
//   - users + magic-link auth
//   - devices owned by users
//   - measurements (single row per sensor sample, all numeric fields nullable
//     so the firmware can grow into them without a migration each time)
// Plants, care rules, notifications, push subscriptions land in later sprints.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now())

  // IANA timezone (e.g. "Europe/Moscow", "Asia/Tashkent"). Determines what
  // "local time" means for this user's quiet hours and morning digest.
  // Detected on first login from the browser's Intl APIs.
  timezone  String   @default("Europe/Moscow")

  // Quiet hours, minutes-from-midnight in the user's local time. Nullable =
  // no quiet hours configured. Both inclusive: e.g. start=23*60, end=7*60.
  quietHoursStartMin Int?
  quietHoursEndMin   Int?

  magicLinks       MagicLinkToken[]
  sessions         Session[]
  devices          Device[]
  plants           Plant[]
  identifications  IdentificationRequest[]
  pushSubs         PushSubscription[]
  notifications    NotificationLog[]
}

model MagicLinkToken {
  id         String    @id @default(uuid())
  token      String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model Session {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Device {
  id          String   @id @default(uuid())
  name        String
  deviceToken String   @unique
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  // Battery self-learning. cyclesSinceLastCharge counts wake-cycles since the
  // last detected charge event (voltage jump ≥ 0.15 V). On charge,
  // cyclesPerFullBattery gets a rolling-average update and the counter resets.
  // Both null on a fresh device — UI shows "ETA appears after first charge".
  cyclesSinceLastCharge Int       @default(0)
  cyclesPerFullBattery  Int?
  lastChargeAt          DateTime?

  measurements Measurement[]
  plant        Plant?

  @@index([userId])
}

// Cached snapshot of a Perenual species we care about. Filled on demand
// the first time a user picks (or the identification flow returns) a given
// scientific name. Care thresholds are derived once and stored here so the
// hot path (`/api/devices/:id/latest`) doesn't have to hit perenual-db.
model PlantSpecies {
  id              String   @id @default(uuid())
  perenualId      Int?     @unique
  scientificName  String   @unique
  commonNameEn    String?
  commonNameRu    String?
  family          String?
  defaultImageUrl String?
  thresholds      Json     // see CareThresholds in src/lib/thresholds.ts
  rawDetails      Json?    // Perenual raw_details_v1_json snapshot — for debugging
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  plants Plant[]
}

// A user's plant. 1:1 with a Device (a device sits in one pot). Either
// linked to a PlantSpecies (after identification) or in "generic profile"
// mode while waiting for identification.
model Plant {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId   String?  @unique
  device     Device?  @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  speciesId  String?
  species    PlantSpecies? @relation(fields: [speciesId], references: [id], onDelete: SetNull)
  name       String        // user-chosen, e.g. "Фикус у окна"
  photoUrl   String?
  identifiedAt DateTime?
  // Last computed ring state — used to detect "entered problem zone"
  // transitions for push triggering.
  lastRingStatus String?  // "cold" | "ok" | "warn" | "alert"
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  events CareEvent[]

  @@index([userId])
}

// One care action — automatically detected from the sensor (e.g. a watering
// shows up as a sudden soil-moisture drop) or entered manually by the user.
// Rendered as a marker on the plant's charts and as an entry in the feed.
model CareEvent {
  id         String   @id @default(uuid())
  plantId    String
  plant      Plant    @relation(fields: [plantId], references: [id], onDelete: Cascade)
  kind       String   // "water" | "fertilize" | "repot" | "moved" | "other"
  occurredAt DateTime
  note       String?
  source     String   @default("manual") // "manual" | "auto"
  createdAt  DateTime @default(now())

  @@index([plantId, occurredAt])
}

// Web Push subscription per browser/device. Multiple per user (e.g. iPhone +
// desktop). On send-failure (4xx) we delete the row.
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  authKey   String
  createdAt DateTime @default(now())

  @@index([userId])
}

// Audit + dedup log for outgoing pushes. The rule engine uses it to enforce
// cooldown (12h per (plant, kind)) and the daily cap (3 / plant / 24h).
model NotificationLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plantId   String?
  kind      String   // "soil_orange" | "soil_red" | "temp_orange" | "temp_red" | "temp_drop" | ...
  title     String
  body      String
  sentAt    DateTime @default(now())
  // null if we suppressed the push (cooldown, quiet hours, daily cap) — still
  // logged so we know we "would have" fired.
  suppressedReason String?

  @@index([userId, plantId, kind, sentAt])
}

// Rate-limit log for Plant.id calls — 3 per rolling 7 days per user.
model IdentificationRequest {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  scientificName String?  // top suggestion's name, for audit
  rawResponse Json?

  @@index([userId, createdAt])
}

model Measurement {
  id         String   @id @default(uuid())
  deviceId   String
  device     Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  measuredAt DateTime
  createdAt  DateTime @default(now())

  // All numeric fields nullable so firmware can omit what isn't supported yet.
  temperatureC    Float?
  humidityPct     Float?
  pressureHpa     Float?
  lux             Float?
  soilMoistureRaw Int?
  soilMoisturePct Float?

  // Battery divider raw read from ADC1_CH3 (GPIO3 on the C3 Super Mini).
  // 1:1 resistor divider (100k:100k) on BAT+ of TP4056 → linear in V_bat
  // over the Li-Ion working range 3.0–4.2 V. Raw → voltage conversion lives
  // in src/lib/battery.ts; storage stays raw to keep DB writes cheap and
  // resolution untouched.
  batteryRaw      Int?

  @@index([deviceId, measuredAt])
}
