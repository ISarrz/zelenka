# App database — Postgres (our writable DB)
DATABASE_URL=postgresql://zelenka:zelenka@app-db:5432/zelenka

# Perenual mirror — read-only, separate container seeded from infra/perenual-seed/
PERENUAL_DATABASE_URL=postgresql://perenual_ro:perenual_ro@perenual-db:5432/perenual

# How long a session cookie lives (days)
SESSION_TTL_DAYS=30

# Magic-link token lifetime (minutes)
MAGIC_LINK_TTL_MIN=15

# Base URL of the PWA — used in magic-link URLs the user clicks
WEB_BASE_URL=http://localhost:5173

# Where the API itself is reachable from the PWA (CORS, etc.)
API_BASE_URL=http://localhost:8080

# Sprint 0: email delivery is "log to console". Production wires Resend later.
MAIL_TRANSPORT=console

# Plant.id key — load from plant_id.txt at repo root in dev; in prod set via secret manager
PLANT_ID_API_KEY=

# Set in production
NODE_ENV=development
PORT=8080
