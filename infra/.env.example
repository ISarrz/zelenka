# Copy to .env.dev (local) or .env.prod (server) and fill in real values.
# Never commit .env files — they're gitignored.

# Node mode
NODE_ENV=development

# Caddy host. Dev: `:80` (HTTP only). Prod: a real domain like `zelenka-api.ru`.
WEB_HOST=:80

# Used to generate magic-link URLs that the user clicks. In dev the email is
# logged to API stdout; in prod the email service sends it.
WEB_BASE_URL=http://localhost

# Only used when Caddy is in HTTPS mode (prod). ACME contact email for
# Let's Encrypt notices.
ACME_EMAIL=admin@example.com

# Our app DB
APP_DB_NAME=zelenka
APP_DB_USER=zelenka
APP_DB_PASSWORD=change-me

# Perenual mirror (separate container). Password is internal — the API uses
# the read-only role.
PERENUAL_DB_PASSWORD=change-me
PERENUAL_RO_PASSWORD=change-me

# Session and magic-link lifetimes
SESSION_TTL_DAYS=30
MAGIC_LINK_TTL_MIN=15

# Sprint 0: only "console" (logs to API stdout). Switch to a real provider
# (Resend / Postmark) when going to prod with real users.
MAIL_TRANSPORT=console

# Plant.id key — fed in from the value in plant_id.txt at the repo root in
# dev; from a secret manager in prod.
PLANT_ID_API_KEY=
